import /init.tee.rc
import /init.recovery.usb.rc
import /init.recovery.hormoz-services.rc
import /hwservicemanager.rc
# import /init.recovery.service.rc   <- file does not exist in this tree (init parse error)

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb0"
    setprop sys.usb.ffs.aio_compat 1
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw:/system/lib64/hw
    setprop crypto.ready 1

# Set hardware properties for crypto HALs
    setprop ro.hardware.gatekeeper trustonic
    setprop ro.hardware.keymaster trustonic
    setprop ro.hardware.keystore_keymint trustonic

on fs
    install_keyring

on late-fs
    # Mount RW partitions which need run fsck
    mount_all /first_stage_ramdisk/fstab.mt6897 --late

on post-fs
    start boot-hal-1-2

    symlink /dev/block/platform/bootdevice /dev/block/bootdevice

    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils
    start mtk.plpath.utils.link

on post-fs-data
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/2-005a/f0_save
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/2-005a/osc_save
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/3-005a/osc_save
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/2-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/aw8697_haptic/2-005a/custom_wave
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/2-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/aw8697_haptic/2-005a/custom_wave
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/3-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/aw8697_haptic/3-005a/custom_wave
    chmod 0666 /sys/class/qcom-haptics/lra_calibration
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/0-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/aw8697_haptic/0-005a/custom_wave
    chmod 0666 /sys/class/qcom-haptics/lra_impedance
    chown system system /sys/bus/i2c/drivers/awinic_haptic/1-005a/f0_save
    chown system system /sys/bus/i2c/drivers/awinic_haptic/1-005a/osc_save
    chown system system /sys/bus/i2c/drivers/awinic_haptic/1-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/awinic_haptic/1-005a/custom_wave

    # Permissions for TEE devices
    chmod 0660 /dev/tee0
    chmod 0660 /dev/teepriv0
    chown system system /dev/tee0
    chown system system /dev/teepriv0

    mkdir /data/vendor_de 0770 system system
    mkdir /data/vendor_de/0 0770 system system
    mkdir /data/vendor_de/0/cryptoeng 0770 system system

    # Start TEE daemon
    start mobicore

service mtk.plpath.utils.link /system/bin/mtk_plpath_utils
    class main
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:recovery:s0

# NOTE: /vendor/bin/hw/android.hardware.vibrator-service.hormoz is NOT present in
# this tree. Re-enable this block (and TW_SUPPORT_INPUT_AIDL_HAPTICS in
# BoardConfig.mk) once a working vendor vibrator service binary is added.
#service vibratorfeature-hal-service /vendor/bin/hw/android.hardware.vibrator-service.hormoz
#    class hal
#    user system
#    group system input
#    seclabel u:r:recovery:s0

#service set_permissive /system/bin/set_permissive.sh
    #user root
    #group root
    #disabled
    #oneshot 
    #seclabel u:r:recovery:s0
    
 #service overrideprops /system/bin/overrideprops.sh
    #user root
    #group root
    #disabled
    #oneshot
    #seclabel u:r:recovery:s0
    
# NOTE: /system/bin/haptic_hal.sh is not shipped in this tree yet.
service haptic_hal /system/bin/haptic_hal.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

on property:twrp.modules.loaded=true
    start haptic_hal      


# Fastbootd service
service fastbootd /system/bin/fastbootd
    class main
    user root
    group root system shell
    disabled
    oneshot
    seclabel u:r:recovery:s0

# Sideload (minadbd)
service minadbd /system/bin/minadbd recovery
    class main
    user root
    group root system shell
    disabled
    oneshot
    seclabel u:r:recovery:s0

# NOTE: gatekeeper-1-0 / keymint-3-0 / tee-1-1 service declarations were
# removed from here — they duplicated (with broken "-Vx::" interface syntax)
# the correct, working declarations already shipped in:
#   vendor/etc/init/android.hardware.gatekeeper-service.trustonic.rc  (vendor.gatekeeper-default)
#   vendor/etc/init/android.hardware.security.keymint@3.0-service.trustonic.rc  (vendor.keymint-trustonic)
#   vendor/etc/init/vendor.trustonic.tee@1.1-service.rc  (tee-1-1)
# Keeping both caused init parse errors and an actual crash loop on keymint-3-0.

on property:crypto.ready=1
    start mobicore

on property:hwservicemanager.ready=true
    start mobicore
    start vendor.gatekeeper-default
    start vendor.keymint-trustonic

on property:ro.crypto.state=unsupported
    stop mobicore
    stop vendor.gatekeeper-default
    stop vendor.keymint-trustonic
    stop tee-supplicant

on property:ro.crypto.state=unencrypted
    stop mobicore
    stop vendor.gatekeeper-default
    stop vendor.keymint-trustonic
    stop tee-supplicant

on property:twrp.decrypt.done=true
    stop mobicore
    stop vendor.gatekeeper-default
    stop vendor.keymint-trustonic
    stop tee-supplicant

on property:crypto.ready=0
    stop mobicore
    stop vendor.gatekeeper-default
    stop vendor.keymint-trustonic
    stop tee-supplicant

# USB OTG host mode
on property:sys.usb.config=none
    write /sys/class/udc/11201000.usb0/device/mode host

on boot
    start health-hal-2-1
    #start set_permissive
    #start overrideprops
    setprop sys.usb.config adb
    
    # Enable USB host mode for OTG
    write /sys/class/udc/11201000.usb0/device/mode host
    chmod 0660 /sys/class/udc/11201000.usb0/device/mode
    chown root system /sys/class/udc/11201000.usb0/device/mode
